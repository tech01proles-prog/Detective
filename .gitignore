```gitignore
# Dependencies
node_modules/
# Build artifacts
dist/
build/
# Environment
.env
.env.local
.env.*
# Editors
.vscode/
.idea/
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
# Logs
*.log
# Temp files
*.tmp
*.swp
*.swo
# OS
.DS_Store
Thumbs.db
# Coverage
coverage/
htmlcov/
.coverage
# TypeScript/JavaScript
*.tsbuildinfo
.next/
.nuxt/
# Java
target/
*.class
*.jar
*.war
# C/C++
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
# Go
*.exe
*.test
# Rust
target/
*.rlib
# Gradle
.gradle/
# MyPy
.mypy_cache/
# PyTest
.pytest_cache/
```