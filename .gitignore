```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.ts
*.tsx

# Environment variables
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Python cache (if any Python files exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db
```